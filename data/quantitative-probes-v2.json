  "policy": {
    "development_only": true,
    "training_admitted": false,
    "test_set_created": false,
    "gold_policy": "Exact integer answers, equal answer byte lengths within each four-item group, balanced label placement, no answer integer present among any supplied trial operands.",
    "context_policy": "Cross both named trials with two assignments of their numerical inputs. Every context and every query requires each label once. Assess context-erased predictions and unconstrained greedy bytes using the existing native evaluator.",
    "comparison": "Freeze this suite before evaluating any model on it. Compare complete identical checkpoints before and after a declared lesson continuation; retain per-skill results and every raw score/output. Do not mix checkpoints from different source exposure or select the best question samples.",
    "contamination_boundary": "Normalize whitespace and check every full authored context and individual trial statement against the three declared training streams. This is an exact textual boundary, not a claim that numerical templates, arithmetic facts, concepts or paraphrases are absent.",
    "source_policy": "These newly authored questions are original evaluation fixtures based on basic mathematical definitions and concepts in reviewed training material. They do not import textbook passages or reserve the published textbook test chapters for tuning.",
    "limits": [
      "Only nonnegative integer arithmetic and idealized scalar physics; no fractions, signs, graphs, diagrams, arbitrary units or broad science coverage.",
      "Two candidate likelihoods are a constrained diagnostic, not open-ended question answering. Greedy exact output is measured separately.",
      "Only four numerical groups per skill and fixed wording. Development results cannot establish broad generalization or reproductive fitness.",
      "All-in-group accuracy is the primary context/query dependency check. Context-only, query-only and constant-choice baselines have zero all-in-group accuracy by construction.",
      "Prepared and checked on the host before GPU use; no model performance is established by the preparation audit.",
      "Numbers were selected against four declared operand-ranking heuristics before any model evaluation. Each heuristic passes exactly half the groups in each skill; stronger strategies remain possible."
    ]
  },
  "case_selection": {
    "seed": 20261004,
    "base_spec_sha256": "ae99312de906f9e0f1a07a95915aa667e03986e9f4cd2ba684de4d7ccc2c3754",
